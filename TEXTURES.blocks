// Sky: 1024 px wide = exactly one wrap around the 360 degree horizon in GZDoom (narrower skies repeat).
// 256 px tall, no scaling: GZDoom shows tall skies unstretched; the bottom fades into a pale haze.
Texture "SKYMC", 1024, 256
{
	Patch "textures/blocks/s_skymc.png", 0, 0
}
